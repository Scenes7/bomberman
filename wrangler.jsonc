{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bomberman",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-01",
  // public/ is served as static assets; only the socket and health check run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/health"]
  },
  // One Durable Object per lobby. SQLite-backed classes are what the free plan allows.
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "routes": [{ "pattern": "bomberman.dreamteamhub.ca", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
